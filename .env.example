# Copiar a .env y completar con los valores reales.

# Base de datos
DATABASE_URL=postgresql://usuario:password@localhost:5432/turno_libre

# JWT
SECRET_KEY=cambiar-por-un-secreto-largo
SECRET_KEY_REFRESH=cambiar-por-otro-secreto-largo
SECRET_KEY_RESET=cambiar-por-otro-secreto-largo
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=60m
JWTRESET_EXPIRES_IN=1h

# CORS / frontend
FRONTEND_URL=http://localhost:5173
FRONTEND_PUBLIC_URL=

# Email (Brevo)
BREVO_API_KEY=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mercado Pago
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Entorno
NODE_ENV=development
