generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Provincia {
  id          Int         @id @default(autoincrement())
  nombre      String
  localidades Localidad[]

  @@map("provincia")
}

model Localidad {
  id           Int        @id @default(autoincrement())
  nombre       String
  codigoPostal String
  provinciaId  Int
  
  provincia    Provincia  @relation(fields: [provinciaId], references: [id])
  complejos    Complejo[]

  @@map("localidad")
}

model PersonaFisica {
  dni             String    @id
  nombre          String
  apellido        String
  fechaNacimiento DateTime  @db.Date
  
  usuarios        Usuario[]

  @@map("personaFisica")
}

model PersonaJuridica {
  cuit        String    @id
  razonSocial String
  
  usuarios    Usuario[]

  @@map("personaJuridica")
}

model TipoUsuario {
  id          Int       @id @default(autoincrement())
  descripcion String
  
  usuarios    Usuario[]

  @@map("tipoUsuario")
}

model Usuario {
  id                  Int              @id @default(autoincrement())
  email               String           @unique
  telefono            String
  password            String
  tipoUsuarioId       Int
  personaFisicaDni    String?
  personaJuridicaCuit String?

  tipoUsuario         TipoUsuario      @relation(fields: [tipoUsuarioId], references: [id])
  personaFisica       PersonaFisica?   @relation(fields: [personaFisicaDni], references: [dni])
  personaJuridica     PersonaJuridica? @relation(fields: [personaJuridicaCuit], references: [cuit])

  complejoEncargado   Complejo?        @relation("EncargadoRelation")
  complejosDueno      Complejo[]       @relation("DuenoRelation")
  turnos              Turno[]

  @@map("usuario")
}

model Complejo {
  id          Int       @id @default(autoincrement())
  direccion   String
  nombre      String
  imagenUrl   String?
  localidadId Int
  encargadoId Int       @unique // Único para la relación 1 a 1
  duenoId     Int

  localidad   Localidad @relation(fields: [localidadId], references: [id])
  encargado   Usuario   @relation("EncargadoRelation", fields: [encargadoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  dueno       Usuario   @relation("DuenoRelation", fields: [duenoId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  canchas     Cancha[]
  horarios    Horario[]
  turnos      Turno[]   // Requerido por la relación inversa desde Turno

  @@map("complejo")
}

model TipoCancha {
  id      Int      @id @default(autoincrement())
  deporte String
  
  canchas Cancha[]

  @@map("tipoCancha")
}

model Cancha {
  nro          Int
  complejoId   Int
  tipoCanchaId Int

  complejo     Complejo   @relation(fields: [complejoId], references: [id], onDelete: Cascade)
  tipoCancha   TipoCancha @relation(fields: [tipoCanchaId], references: [id])

  precios      Precio[]
  turnos       Turno[]

  @@id([complejoId, nro]) // Clave primaria compuesta
  @@map("cancha")
}

model Horario {
  complejoId   Int
  nroDia       Int
  horaApertura DateTime @db.Time
  horaCierre   DateTime @db.Time

  complejo     Complejo @relation(fields: [complejoId], references: [id])

  @@id([complejoId, nroDia])
  @@map("horario")
}

model Precio {
  precioBase      Decimal  @db.Decimal(18, 2)
  precioAdicional Decimal  @db.Decimal(18, 2)
  precioSena      Decimal  @db.Decimal(18, 2)
  fechaDesde      DateTime @db.Date
  complejoId      Int
  canchaNro       Int

  cancha          Cancha   @relation(fields: [complejoId, canchaNro], references: [complejoId, nro])

  @@id([complejoId, canchaNro, fechaDesde])
  @@map("precio")
}

model TipoTurno {
  id          Int     @id @default(autoincrement())
  nombre      String
  descripcion String
  
  turnos      Turno[]

  @@map("tipoTurno")
}

model Turno {
  id                Int        @id @default(autoincrement())
  horaInicio        DateTime   @db.Time
  horaFin           DateTime   @db.Time
  estado            String
  motivoCancelacion String?
  fecha             DateTime   @db.Date
  clienteId         Int
  tipoTurnoId       Int
  complejoId        Int
  canchaNro         Int

  cliente           Usuario    @relation(fields: [clienteId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tipoTurno         TipoTurno  @relation(fields: [tipoTurnoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  complejo          Complejo   @relation(fields: [complejoId], references: [id])
  cancha            Cancha     @relation(fields: [complejoId, canchaNro], references: [complejoId, nro], onDelete: NoAction, onUpdate: NoAction)

  @@map("turno")
}
