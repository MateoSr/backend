generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Provincia {
  id          Int         @id @default(autoincrement())
  nombre      String
  localidades Localidad[]

  @@map("provincia")
}

model Localidad {
  id           Int        @id @default(autoincrement())
  nombre       String
  codigoPostal String
  provinciaId  Int
  complejos    Complejo[]
  provincia    Provincia  @relation(fields: [provinciaId], references: [id], map: "localidad_provinciaId_fkey")

  @@map("localidad")
}

model PersonaFisica {
  dni             String    @id
  nombre          String
  apellido        String
  fechaNacimiento DateTime  @db.Date
  usuarios        Usuario[]

  @@map("personaFisica")
}

model PersonaJuridica {
  cuit        String    @id
  razonSocial String
  usuarios    Usuario[]

  @@map("personaJuridica")
}

model TipoUsuario {
  id          Int       @id @default(autoincrement())
  descripcion String
  usuarios    Usuario[]

  @@map("tipoUsuario")
}

model Usuario {
  id                  Int              @id @default(autoincrement())
  email               String           @unique
  telefono            String
  password            String
  tipoUsuarioId       Int
  personaFisicaDni    String?
  personaJuridicaCuit String?
  complejosDueno      Complejo[]       @relation("Dueno")
  complejoEncargado   Complejo?        @relation("Encargado")
  ordenesPago         OrdenPago[]
  turnos              Turno[]          @relation("Cliente")
  personaFisica       PersonaFisica?   @relation(fields: [personaFisicaDni], references: [dni], map: "usuario_personaFisicaDni_fkey")
  personaJuridica     PersonaJuridica? @relation(fields: [personaJuridicaCuit], references: [cuit], map: "usuario_personaJuridicaCuit_fkey")
  tipoUsuario         TipoUsuario      @relation(fields: [tipoUsuarioId], references: [id], map: "usuario_tipoUsuarioId_fkey")

  @@map("usuario")
}

model Complejo {
  id          Int         @id @default(autoincrement())
  direccion   String
  nombre      String
  localidadId Int
  encargadoId Int         @unique
  duenoId     Int
  imagenUrl   String?
  instagram   String?
  telefono    String
  estado      String      @default("Activo")
  canchas     Cancha[]
  dueno       Usuario     @relation("Dueno", fields: [duenoId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "complejo_duenoId_fkey")
  encargado   Usuario     @relation("Encargado", fields: [encargadoId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "complejo_encargadoId_fkey")
  localidad   Localidad   @relation(fields: [localidadId], references: [id], map: "complejo_localidadId_fkey")
  horarios    Horario[]
  opiniones   Opinion[]
  ordenesPago OrdenPago[]
  turnos      Turno[]     @relation("ComplejoTurnos")

  @@map("complejo")
}

model Opinion {
  id          Int      @id @default(autoincrement())
  descripcion String
  fecha       DateTime @default(now()) @db.Timestamptz(6)
  id_complejo Int
  complejo    Complejo @relation(fields: [id_complejo], references: [id], onDelete: Cascade, map: "opinion_id_complejo_fkey")

  @@map("opinion")
}

model TipoCancha {
  id       Int      @id @default(autoincrement())
  deporte  String
  duracion Int
  canchas  Cancha[]

  @@map("tipoCancha")
}

model Cancha {
  nro          Int
  complejoId   Int
  tipoCanchaId Int
  estado       String      @default("Activo")
  complejo     Complejo    @relation(fields: [complejoId], references: [id], onDelete: Cascade, map: "cancha_complejoId_fkey")
  tipoCancha   TipoCancha  @relation(fields: [tipoCanchaId], references: [id], map: "cancha_tipoCanchaId_fkey")
  ordenesPago  OrdenPago[]
  precios      Precio[]
  turnos       Turno[]     @relation("CanchaTurnos")

  @@id([complejoId, nro])
  @@map("cancha")
}

model Horario {
  complejoId   Int
  nroDia       Int
  horaApertura String   @db.VarChar(5)
  horaCierre   String   @db.VarChar(5)
  complejo     Complejo @relation(fields: [complejoId], references: [id], map: "horario_complejoId_fkey")

  @@id([complejoId, nroDia])
  @@map("horario")
}

model Precio {
  precioBase      Decimal  @db.Decimal(18, 2)
  precioAdicional Decimal  @db.Decimal(18, 2)
  precioSena      Decimal  @db.Decimal(18, 2)
  fechaDesde      DateTime @db.Date
  complejoId      Int
  canchaNro       Int
  cancha          Cancha   @relation(fields: [complejoId, canchaNro], references: [complejoId, nro], map: "precio_complejoId_canchaNro_fkey")

  @@id([complejoId, canchaNro, fechaDesde])
  @@map("precio")
}

model TipoTurno {
  id          Int     @id @default(autoincrement())
  nombre      String
  descripcion String
  turnos      Turno[]

  @@map("tipoTurno")
}

model Turno {
  id                  Int        @id @default(autoincrement())
  estado              String
  motivoCancelacion   String?
  clienteId           Int?
  tipoTurnoId         Int
  complejoId          Int
  canchaNro           Int
  fechaInicio         DateTime   @db.Timestamptz(6)
  fechaFin            DateTime   @db.Timestamptz(6)
  apellidoSolicitante String?
  nombreSolicitante   String?
  ordenPago           OrdenPago?
  cliente             Usuario?   @relation("Cliente", fields: [clienteId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "turno_clienteId_fkey")
  cancha              Cancha     @relation("CanchaTurnos", fields: [complejoId, canchaNro], references: [complejoId, nro], onDelete: NoAction, onUpdate: NoAction, map: "turno_complejoId_canchaNro_fkey")
  complejo            Complejo   @relation("ComplejoTurnos", fields: [complejoId], references: [id], map: "turno_complejoId_fkey")
  tipoTurno           TipoTurno  @relation(fields: [tipoTurnoId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "turno_tipoTurnoId_fkey")

  @@map("turno")
}

model OrdenPago {
  id                Int      @id @default(autoincrement())
  mpOrderId         String?  @unique
  externalReference String   @unique
  clienteId         Int?
  complejoId        Int
  canchaNro         Int
  fechaInicio       DateTime @db.Timestamptz(6)
  fechaFin          DateTime @db.Timestamptz(6)
  monto             Decimal  @db.Decimal(18, 2)
  estado            String   @default("pendiente")
  motivoRechazo     String?
  turnoId           Int?     @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  cliente           Usuario? @relation(fields: [clienteId], references: [id])
  cancha            Cancha   @relation(fields: [complejoId, canchaNro], references: [complejoId, nro])
  complejo          Complejo @relation(fields: [complejoId], references: [id])
  turno             Turno?   @relation(fields: [turnoId], references: [id])

  @@index([complejoId, canchaNro, fechaInicio, fechaFin])
  @@map("ordenPago")
}
